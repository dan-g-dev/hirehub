# ---------------------------------------------------------
# HireHub Ethiopia — Backend environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ---------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# The origin the frontend dev server runs on (Vite default: 5173).
# Used for CORS. In production, set this to your deployed frontend URL.
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Database (see /database/schema.sql for the table definitions —
# run that file once against your MySQL server before starting the
# backend, then run `npm run seed` to load realistic Ethiopian demo data)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hirehub_user
DB_PASSWORD=secure_password
DB_NAME=hirehub_ethiopia
# Alternative: set DATABASE_URL instead and leave the DB_* vars unset.
# DATABASE_URL=mysql://hirehub_user:secure_password@localhost:3306/hirehub_ethiopia

# AI CV matching (Google Gemini). If left blank, the AI endpoint
# automatically falls back to a rule-based skill matcher instead
# of failing or faking a result.
GEMINI_API_KEY=

# Email notifications (Nodemailer). If left blank, emails are
# logged to the console instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HireHub Ethiopia <no-reply@hirehub.et>"
